<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>ScooterLog</string>
<key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UIApplicationShortcutItems</key>
<array>
    <dict>
        <key>UIApplicationShortcutItemType</key><string>com.scooterlog.startRide</string>
        <key>UIApplicationShortcutItemTitle</key><string>Start ride</string>
        <key>UIApplicationShortcutItemSubtitle</key><string>Record on this iPhone</string>
        <key>UIApplicationShortcutItemIconSymbolName</key><string>play.circle.fill</string>
    </dict>
</array>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>NSLocationWhenInUseUsageDescription</key><string>ScooterLog uses your current location to plan directions and records your route and timing only when you start a ride.</string>
<key>NSHealthShareUsageDescription</key><string>Optionally show available heart-rate samples during your ride. No workouts or health data are written.</string>
<key>NSHealthUpdateUsageDescription</key><string>ScooterLog does not write Health data on iPhone. On Apple Watch, workout permission enables an optional live heart-rate session. ScooterLog discards its workout results instead of saving a workout; watchOS may still create Health samples or ring effects.</string>
<key>UIBackgroundModes</key><array><string>location</string></array>
<key>NSSupportsLiveActivities</key><true/>
<key>ScooterCloudContainer</key><string>$(CLOUDKIT_CONTAINER_IDENTIFIER)</string>
</dict></plist>
